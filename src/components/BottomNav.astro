---
import { localizedPath, withBase } from '../lib/routes';

const locale = Astro.currentLocale === 'en' || Astro.url.pathname.includes('/en/') ? 'en' : 'ja';
const items = [
  { path: '/', icon: '⌂', ja: 'ホーム', en: 'Home' },
  { path: '/recipes/', icon: '◉', ja: '撮り方', en: 'Recipes' },
  { path: '/controls/', icon: '⌁', ja: '設定', en: 'Controls' },
  { path: '/help/', icon: '?', ja: 'ヘルプ', en: 'Help' }
] as const;
---

<nav class="bottom-nav" aria-label={locale === 'ja' ? '主なページ' : 'Main pages'}>
  {
    items.map((item) => {
      const href = withBase(localizedPath(item.path, locale));
      const cleanCurrent = Astro.url.pathname.replace(/\/$/, '');
      const cleanHref = href.replace(/\/$/, '');
      const active =
        item.path === '/' ? cleanCurrent === cleanHref : cleanCurrent.startsWith(cleanHref);
      return (
        <a href={href} aria-current={active ? 'page' : undefined}>
          <span aria-hidden="true">{item.icon}</span>
          {item[locale]}
        </a>
      );
    })
  }
</nav>
