---
import { publicRecipes, settingLabel } from '../../data/recipes';
const picks = [
  'everyday-photo',
  'sunset',
  'moving-subject',
  'night-city',
  'people-portrait',
  'wide-landscape',
  'flower-closeup',
  'panorama',
  'video-basics'
]
  .map((slug) => publicRecipes.find((recipe) => recipe.slug === slug))
  .filter(Boolean);
---

<html lang="ja">
  <head
    ><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>
      anko-foto Camera Guide — 日本語 / English
    </title></head
  >
  <body
    ><main>
      <header>
        <p>日本語 / English</p><h1>anko-foto Camera Guide</h1><p>
          撮りたいものから始める · Start with what you want to shoot
        </p>
      </header>
      {
        picks.map(
          (recipe) =>
            recipe && (
              <article>
                <>
                  <h2>
                    {recipe.title.ja}
                    <small>{recipe.title.en}</small>
                  </h2>
                  <div class="columns">
                    <>
                      <div>
                        <>
                          <h3>まずこれ</h3>
                          <ol>
                            {recipe.tryFirst.map((step) => (
                              <li>{step.ja}</li>
                            ))}
                          </ol>
                        </>
                      </div>
                      <div>
                        <>
                          <h3>Try this first</h3>
                          <ol>
                            {recipe.tryFirst.map((step) => (
                              <li>{step.en}</li>
                            ))}
                          </ol>
                        </>
                      </div>
                    </>
                  </div>
                  <p class="settings">
                    {recipe.settings.map((s) => settingLabel(s, 'ja')).join(' · ')}
                    <br />
                    {recipe.settings.map((s) => settingLabel(s, 'en')).join(' · ')}
                  </p>
                </>
              </article>
            )
        )
      }
      <footer>
        安全が先 · Safety first — 歩きながら画面を見ない · Do not watch the screen while walking.
      </footer>
    </main></body
  >
</html>
<style>
  @page {
    size: A4;
    margin: 14mm;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, 'Noto Sans JP', sans-serif;
    color: #10223b;
  }
  header {
    padding: 10mm;
    border-radius: 5mm;
    background: #10223b;
    color: white;
  }
  header p {
    margin: 0 0 2mm;
  }
  h1 {
    margin: 0;
    font-size: 26pt;
  }
  article {
    break-inside: avoid;
    margin-top: 6mm;
    padding: 5mm;
    border: 0.4mm solid #d3dce4;
    border-radius: 4mm;
  }
  h2 {
    margin: 0 0 3mm;
    color: #176d91;
    font-size: 16pt;
  }
  h2 small {
    display: block;
    color: #526176;
    font-size: 10pt;
  }
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8mm;
  }
  h3 {
    margin: 0;
    font-size: 10pt;
  }
  ol {
    margin: 1mm 0 0;
    padding-left: 5mm;
    font-size: 9pt;
  }
  .settings {
    margin: 3mm 0 0;
    padding: 2.5mm;
    background: #fff3d6;
    font-size: 9pt;
    font-weight: 700;
  }
  footer {
    margin-top: 8mm;
    padding-top: 4mm;
    border-top: 1.2mm solid #db5b45;
    font-weight: 700;
  }
</style>
